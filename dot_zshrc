# ~/.zshrc — interactive shell setup.
# Homebrew and OrbStack PATH entries live in ~/.zprofile (login shell), not here.
#
# Sections: Environment · Options · History · Keys · Completion · Prompt · Aliases · Functions

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
export EDITOR=vim
export CLICOLOR=1                          # colored `ls` (BSD/macOS)
export LSCOLORS=ExGxBxDxCxEgEdxbxgxcxd

typeset -U path                            # PATH never holds duplicates
path=(
  "$HOME/.local/bin"                       # uv, claude, swamp
  $path
  "$HOME/go/bin"                           # GOPATH default; avoids `go env` per startup
)

# ---------------------------------------------------------------------------
# Options
# ---------------------------------------------------------------------------
setopt AUTO_CD                             # `some/dir` alone means `cd some/dir`
setopt AUTO_PUSHD                          # every cd is pushed; `cd -<Tab>` to go back
setopt PUSHD_IGNORE_DUPS
setopt INTERACTIVE_COMMENTS                # allow `# comment` on the command line
unsetopt BEEP

# ---------------------------------------------------------------------------
# History
# ---------------------------------------------------------------------------
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY                       # all open shells share one live history
setopt EXTENDED_HISTORY                    # save timestamp + duration per command
setopt HIST_IGNORE_ALL_DUPS                # repeated command keeps only the newest copy
setopt HIST_IGNORE_SPACE                   # leading space = don't record this command
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY                         # `!!` expands onto the line first, run on second Enter

# ---------------------------------------------------------------------------
# Keys
# ---------------------------------------------------------------------------
# Emacs keymap: Ctrl+A/E (line start/end), Ctrl+W (delete word), Ctrl+R (search), etc.
# Without this zsh picks vi mode because EDITOR contains "vi".
bindkey -e

# Up / Down: step through history entries that start with what's already typed
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey '^[OA' up-line-or-beginning-search   # same keys in application-cursor mode
bindkey '^[OB' down-line-or-beginning-search

# Ctrl+X Ctrl+E: open the current command line in $EDITOR
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^X^E' edit-command-line

# Treat / . - as word boundaries so Ctrl+W deletes one path segment, not the whole path
WORDCHARS='*?_[]~=&;!#$%^(){}<>'

# ---------------------------------------------------------------------------
# Completion
# ---------------------------------------------------------------------------
autoload -Uz compinit
compinit

zstyle ':completion:*' menu select                          # Tab Tab → arrow-key menu
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'   # case-insensitive
zstyle ':completion:*' list-colors ''                       # color entries (default scheme)
zstyle ':completion:*' group-name ''                        # group by type (files, options, ...)
zstyle ':completion:*:descriptions' format '%F{yellow}── %d ──%f'

# ---------------------------------------------------------------------------
# Prompt
# ---------------------------------------------------------------------------
#   [user@host:~/path] [branch*+]      * = unstaged changes   + = staged changes
#   $                                  $ turns red when the last command failed
autoload -Uz vcs_info add-zsh-hook
add-zsh-hook precmd vcs_info

zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:*' check-for-changes true
zstyle ':vcs_info:*' unstagedstr '*'
zstyle ':vcs_info:*' stagedstr '+'
zstyle ':vcs_info:git:*' formats ' [%b%u%c]'
zstyle ':vcs_info:git:*' actionformats ' [%b|%a%u%c]'   # %a = rebase / merge / etc.

setopt PROMPT_SUBST
PROMPT='%F{cyan}[%n@%m:%~]%f%F{yellow}${vcs_info_msg_0_}%f
%(?.%F{green}.%F{red})$%f '

# ---------------------------------------------------------------------------
# Aliases
# ---------------------------------------------------------------------------
# Navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# Listing
alias ll='ls -lah'
alias la='ls -A'
alias l='ls -CF'

# Git
alias gs='git status'
alias ga='git add'
alias gaa='git add .'
alias gc='git commit'
alias gca='git commit -a'
alias gco='git checkout'
alias gcb='git checkout -b'
alias gb='git branch'
alias gd='git diff'
alias gl='git log --oneline --graph --decorate'
alias gp='git push'
alias gpl='git pull'

# Docker
alias d='docker'
alias dc='docker compose'
alias dps='docker ps'
alias dpsa='docker ps -a'
alias di='docker images'
alias dex='docker exec -it'
alias dlogs='docker logs -f'
alias dstop='docker stop $(docker ps -q)'   # stop every running container
alias dclean='docker system prune -af'      # CAUTION: removes all stopped containers + unused images, no prompt

# Ask before clobbering
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

# Misc
alias grep='grep --color=auto'
alias mkdir='mkdir -pv'                     # create parents, print what was made
alias path='print -l $path'                 # PATH one entry per line
alias reload='exec zsh'                     # fresh shell; also drops aliases removed from this file
alias myip='curl -s https://api.ipify.org && echo'
alias ssh='TERM=xterm-256color ssh'         # remote hosts rarely have ghostty terminfo

# ---------------------------------------------------------------------------
# Functions
# ---------------------------------------------------------------------------
# mkcd DIR      create a directory and cd into it
mkcd() { mkdir -p "$1" && cd "$1"; }

# qfind NAME    find files under . whose name contains NAME (case-insensitive)
qfind() { find . -iname "*$1*"; }

# dbash NAME    bash shell inside a running container
dbash() { docker exec -it "$1" /bin/bash; }

# dsh NAME      sh shell inside a running container (alpine and friends)
dsh() { docker exec -it "$1" /bin/sh; }
